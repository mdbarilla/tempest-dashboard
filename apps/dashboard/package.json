{
  "name": "tempest-dashboard",
  "version": "1.5.4",
  "description": "Minimalist Tempest weather dashboard for Raspberry Pi",
  "private": true,
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.28.0",
    "react-scripts": "5.0.1",
    "axios": "^1.6.2",
    "recharts": "^2.10.3"
  },
  "scripts": {
    "start": "react-scripts start",
    "start:pi": "REACT_APP_API_URL=http://towerhill.local:3001/api/weather react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "proxy": "http://localhost:3001"
}
