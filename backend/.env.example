# Tempest API Configuration
TEMPEST_API_TOKEN=your_token_here
TEMPEST_STATION_ID=your_station_id_here
# Optional: for 3d/7d charts when Pi is offline - fill gaps from WeatherFlow device observations.
# Get device_id from: GET https://swd.weatherflow.com/swd/rest/stations?token=YOUR_TOKEN (see devices[].device_id)
# TEMPEST_DEVICE_ID=12345
TEMPEST_LATITUDE=42.3725
TEMPEST_LONGITUDE=-71.3161

# Server Configuration
PORT=3001
NODE_ENV=development

# Database
DATABASE_PATH=./data/weather.db

# Cache settings (in seconds)
CACHE_CURRENT_WEATHER=60
CACHE_FORECAST=300

# NWS alerts (optional; uses TEMPEST_LATITUDE/LONGITUDE)
# NWS_ALERTS_TTL=600
# NWS_USER_AGENT=Tempest (https://github.com/tempest-weather); you@example.com

# AI weather bridge (weather_bridge.py on Pi); powers atmosphere.description in /complete
# When backend runs on Mac and bridge on Pi: AI_BRIDGE_URL=http://towerhill.local:5000
# AI_BRIDGE_URL=http://localhost:5000
# Set to true (or 1) to enable LLM; required in production when bridge URL is .local/localhost
AI_BRIDGE_ENABLED=true
# AI_BRIDGE_TIMEOUT=3000

# Google Home / Dialogflow (optional)
DIALOGFLOW_PROJECT_ID=your_project_id
